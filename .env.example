# Lecția 6 — 12-Factor App: config-ul trăiește în mediu, nu în cod.
# Copiază acest fișier în .env (ignorat de git) și completează valorile reale.
# Niciuna dintre variabilele de mai jos nu are o valoare hardcodată în application.yaml.

# ---- Comun ----
# dev (implicit dacă lipsește) sau prod.
SPRING_PROFILES_ACTIVE=dev

# ---- Profilul dev ----
# Toate au deja o valoare implicită în application-dev.yaml — setează-le doar
# dacă vrei să suprascrii ceva local (ex. alt port de Redis).
APP_DB_PASSWORD=2302
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_JWT_SECRET=impact-academies-dev-secret-key-do-not-use-in-production-0123456789

# ---- Profilul prod ----
# Niciuna nu are valoare implicită — aplicația refuză să pornească fără ele.
# APP_DB_URL=jdbc:postgresql://<host>:5432/e-commerce
# APP_DB_USERNAME=<db-user>
# APP_DB_PASSWORD=<db-password>
# APP_REDIS_HOST=<redis-host>
# APP_REDIS_PORT=6379
# APP_JWT_SECRET=<secret lung, generat aleator — NU cel de mai sus>
# APP_CORS_ALLOWED_ORIGINS=https://domeniul-real-al-frontendului.example
# PORT=8080
